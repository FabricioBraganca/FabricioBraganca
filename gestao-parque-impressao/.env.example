APP_NAME="API de Gestão de Ativos"
APP_ENV=development
DEBUG=false
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

POSTGRES_DB=asset_management
POSTGRES_USER=toner
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://toner:change-this-database-password@db:5432/asset_management

SECRET_KEY=change-this-secret-key-before-deployment-use-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7